.container.mt-5
  .row.justify-content-center
    .col-md-4
      .card.theme-card
        .card-body
          %h2.text-center.mb-4 Вход в систему
          
          = form_for(:session, url: signin_path) do |f|
            .mb-3
              = f.label :email, "Email", class: "form-label"
              = f.email_field :email, class: "form-control", placeholder: "example@mail.ru", required: true
            
            .mb-3
              = f.label :password, "Пароль", class: "form-label"
              = f.password_field :password, class: "form-control", placeholder: "******", required: true
            
            .d-grid
              = f.submit "Войти", class: "btn-create"
          
          %hr
          .text-center
            %p
              Нет аккаунта?
              = link_to "Зарегистрироваться", signup_path, class: "btn-link"
