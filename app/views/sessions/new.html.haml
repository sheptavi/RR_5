.container.mt-5
  .row.justify-content-center
    .col-md-4
      .card.theme-card
        .card-body
          %h2.text-center.mb-4= t('sessions.new.title')
          
          = form_for(:session, url: signin_path) do |f|
            .mb-3
              = f.label :email, t('sessions.new.email'), class: "form-label"
              = f.email_field :email, class: "form-control", placeholder: "example@mail.ru", required: true
            
            .mb-3
              = f.label :password, t('sessions.new.password'), class: "form-label"
              = f.password_field :password, class: "form-control", placeholder: "******", required: true
            
            .d-grid
              = f.submit t('sessions.new.submit'), class: "btn-create"
          
          %hr
          .text-center
            %p
              = t('sessions.new.no_account')
              = link_to t('sessions.new.sign_up'), signup_path, class: "btn-link"
