.container.mt-4
  .row
    .col-md-3
      .card.theme-card
        .card-body
          %h4= t('work.index.select_theme')
          .select_theme
            %button.btn-create#select_theme_btn{style: "width: 100%;"}= t('work.index.select_theme_btn')
          .theme_select_container{style: "display: none; margin-top: 15px;"}
            %select#theme_dropdown.form-select
              %option{value: ""} --- #{t('work.index.select_theme')} ---
      
    .col-md-9
      .card.theme-card.image_display
        .card-body
          .up-theme.text-center
            %h2= t('work.index.default_theme')
          
          .up.text-center.mt-2{style: "color: #6c757d; font-size: 1.2rem;"}
            = t('work.index.image_not_selected')
          
          .row.mt-4
            .col-md-1.img-left-side{style: "display: none;"}
              .text-center
                %i.fa.fa-chevron-circle-left.fa-2x{style: "cursor: pointer; color: #8b5cf6;"}
            
            .col-md-10.img-center.text-center
              %img#main_image{src: "https://picsum.photos/id/1/500/400", alt: t('work.index.image_not_selected'), style: "width: 100%; border-radius: 15px;"}

            .col-md-1.img-right-side{style: "display: none;"}
              .text-center
                %i.fa.fa-chevron-circle-right.fa-2x{style: "cursor: pointer; color: #8b5cf6;"}
          
          .row.mt-4
            .col-md-12
              .rating-area.text-center
                %h4= t('work.index.your_rating')
                .rating-buttons.mt-2
                  - (1..10).each do |i|
                    %button.btn-rating{data: {value: i}, style: "margin: 3px;"}= i
                .mt-3
                  %button.btn-create#save_rating= t('work.index.save_rating')
                .mt-2
                  %small.text-muted= t('work.index.hint')
              
              .result-area.mt-4
                %h4= t('work.index.results')
                %p#user_value= "#{t('work.index.user_value')} "
                %p#common_value= "#{t('work.index.common_value')} "

          .theme_select_container{style: "display: none; margin-top: 15px;"}
            %select#theme_dropdown.form-select
              %option{value: ""} --- #{t('work.index.select_theme')} ---
