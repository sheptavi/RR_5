// Получаем данные из контроллера
var imageData = '<%= raw @image_data.to_json %>';
console.log("IN display_theme: @image_data = " + imageData);

var valuesQty = '<%= @image_data[:values_qty] %>';
console.log("IN display_theme: valuesQty = " + valuesQty);

// Обновляем счётчик оценок
$('.left_controls span.total_values h2.total').html(valuesQty);

// Показываем/скрываем кнопки в зависимости от выбранной темы
var selectedTheme = '<%= @image_data[:theme] %>';
if (selectedTheme == "Выберите тему для оценки" || selectedTheme == "" || selectedTheme == "Select theme to leave your answer") {
  $('.img-left-side').hide();
  $('.img-right-side').hide();
  $('.image .image_display .image_diag').hide();
} else {
  $('.img-left-side').show();
  $('.img-right-side').show();
  $('.image .image_display .image_diag').show();
}

// Обновляем название темы
$('.image_display h2.up-theme').html(selectedTheme);

// Восстанавливаем кнопку выбора темы
$('.select_theme').empty().html('<%= j render "work/button_theme_select" %>');

// Обновляем название изображения
var oneImageName = '<%= @image_data[:name] %>';
$('.image_display h2.up').html(oneImageName);

// Обновляем картинку
var oneImageFile = '<%= @image_data[:file] %>';
var pathImage = oneImageFile;
console.log("IN display_theme: pathImage = " + pathImage);
$(".img-center img").attr("src", pathImage);

// Сохраняем данные для дальнейшего использования
var oneImageId = '<%= @image_data[:image_id] %>';
var themeImagesSize = '<%= @image_data[:images_arr_size] %>';
var selectedThemeId = '<%= @image_data[:theme_id] %>';
var currentIndex = '<%= @image_data[:index] %>';
var userValue = '<%= @image_data[:value] %>';
var commonValue = '<%= @image_data[:common_ave_value] %>';

$('#user_value').text('Ваша оценка: ' + (userValue > 0 ? userValue : 'не оценено'));
$('#common_value').text('Средняя оценка экспертов: ' + (commonValue > 0 ? commonValue : 'нет оценок'));
