.container.mt-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1= t('themes.index.title')
    = link_to t('themes.index.new_theme'), new_theme_path, class: "btn-create"

  - if @themes.any?
    .row
      - @themes.each do |theme|
        .col-md-4.mb-4
          .card.theme-card
            .card-body
              %h5.card-title= theme.translated_name
              %p.card-text
                = t('themes.index.images_count')
                %span.badge-counter= theme.images.count
              .d-flex.gap-2.justify-content-center.mt-4
                = link_to t('themes.index.show'), theme, class: "btn-action"
                = link_to t('themes.index.edit'), edit_theme_path(theme), class: "btn-action"
                = link_to t('themes.index.delete'), theme, method: :delete, data: { confirm: t('themes.index.confirm') }, class: "btn-action"
  - else
    .alert.alert-info.text-center
      = t('themes.index.no_themes')
      = link_to t('themes.index.create_first'), new_theme_path, class: "btn-create ms-2"
