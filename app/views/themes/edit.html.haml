.container.mt-4
  %h1 Редактирование темы
  
  = form_with model: @theme, local: true do |f|
    .mb-3
      = f.label :name, "Название темы", class: "form-label"
      = f.text_field :name, class: "form-control", required: true
    
    .mb-3
      = f.label :qty_items, "Количество изображений", class: "form-label"
      = f.number_field :qty_items, class: "form-control", min: 0

    .d-flex.gap-2.justify-content-center
      = f.submit "Обновить тему", class: "btn-create"
      = link_to "Отмена", themes_path, class: "btn-create"
