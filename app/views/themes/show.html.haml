.container.mt-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1= @theme.translated_name
    = link_to t('actions.edit'), edit_theme_path(@theme), class: "btn-create"

  .card.theme-card
    .card-body
      %p
        %strong= t('themes.index.images_count')
        = @theme.images.count
      %p
        %strong= t('activerecord.attributes.theme.created_at')
        = l(@theme.created_at.to_date, format: :default) if @theme.created_at

  .mt-4
    = link_to t('actions.back'), themes_path, class: "btn-create"
