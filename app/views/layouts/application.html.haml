!!!
%html{lang: I18n.locale}
  %head
    %title Мой курсовой проект
    = csrf_meta_tags
    = csp_meta_tag
    = favicon_link_tag 'favicon.ico'

    / Bootstrap 5 CSS
    %link{href: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", rel: "stylesheet"}

    / Font Awesome 6 (иконки)
    %link{rel: "stylesheet", href: "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"}

    / Твои стили
    = stylesheet_link_tag 'application', media: 'all'
    = javascript_include_tag 'application'

    / Переводы для JavaScript
    :javascript
      window.I18nLocale = '#{I18n.locale}';
      window.i18n = {
        user_value: "#{j(t('work.index.user_value'))}",
        common_value: "#{j(t('work.index.common_value'))}",
        not_rated: "#{j(t('work.index.not_rated'))}",
        no_ratings: "#{j(t('work.index.no_estimates'))}"
      };

  %body
    = render 'shared/header'

    .container.mt-4
      = yield

    = render 'shared/footer'

    / Bootstrap 5 JavaScript
    %script{src: "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"}
