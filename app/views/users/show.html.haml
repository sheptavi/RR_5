.container.mt-4
  .row
    .col-md-4
      .card.theme-card.text-center
        .card-body
          = gravatar_for @user, size: 150
          %h2.mt-3= @user.name
          %p.text-muted= @user.email
          = link_to t('users.show.go_to_work'), work_path(locale: I18n.locale), class: "btn-create mt-3"
    
    .col-md-8
      .card.theme-card
        .card-body
          %h3= t('users.show.my_stats')
          %hr
          %p
            %strong= t('users.show.total_ratings')
            = @user.values.count
          %p
            %strong= t('users.show.average_rating')
            - if @user.values.average(:value).present?
              = @user.values.average(:value).round(2)
            - else
              = t('users.show.no_ratings')
          
          %h3.mt-4= t('users.show.my_ratings')
          %hr
          - if @user.values.any?
            .table-responsive
              %table.table.table-hover
                %thead
                  %tr
                    %th= t('users.show.image')
                    %th= t('users.show.rating')
                    %th= t('users.show.date')
                %tbody
                  - @user.values.order(created_at: :desc).each do |value|
                    %tr
                      %td= value.image&.translated_name || t('users.show.unknown')
                      %td
                        %span.badge.bg-primary= value.value
                      %td= l(value.created_at.to_date, format: :default)
          - else
            .alert.alert-info
              = t('users.show.no_ratings')
