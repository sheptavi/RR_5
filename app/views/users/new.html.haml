.container.mt-5
  .row.justify-content-center
    .col-md-4
      .card.theme-card
        .card-body
          %h2.text-center.mb-4 Регистрация
          
          = form_for(@user, url: signup_path) do |f|
            - if @user.errors.any?
              .alert.alert-danger
                %h5 Ошибка:
                %ul
                  - @user.errors.full_messages.each do |msg|
                    %li= msg
            
            .mb-3
              = f.label :name, "Имя", class: "form-label"
              = f.text_field :name, class: "form-control", required: true
            
            .mb-3
              = f.label :email, "Email", class: "form-label"
              = f.email_field :email, class: "form-control", required: true
            
            .mb-3
              = f.label :password, "Пароль (минимум 6 символов)", class: "form-label"
              = f.password_field :password, class: "form-control", required: true
            
            .mb-3
              = f.label :password_confirmation, "Подтверждение пароля", class: "form-label"
              = f.password_field :password_confirmation, class: "form-control", required: true
            
            .d-grid
              = f.submit "Зарегистрироваться", class: "btn-create"
          
          %hr
          .text-center
            %p
              Уже есть аккаунт?
              = link_to "Войти", signin_path, class: "btn-link"
