.container.mt-5
  .row.justify-content-center
    .col-md-4
      .card.theme-card
        .card-body
          %h2.text-center.mb-4= t('users.new.title')
          
          = form_for(@user, url: signup_path) do |f|
            - if @user.errors.any?
              .alert.alert-danger
                %h5= t('users.new.error')
                %ul
                  - @user.errors.full_messages.each do |msg|
                    %li= msg
            
            .mb-3
              = f.label :name, t('users.new.name'), class: "form-label"
              = f.text_field :name, class: "form-control", required: true
            
            .mb-3
              = f.label :email, t('users.new.email'), class: "form-label"
              = f.email_field :email, class: "form-control", required: true
            
            .mb-3
              = f.label :password, t('users.new.password'), class: "form-label"
              = f.password_field :password, class: "form-control", required: true
            
            .mb-3
              = f.label :password_confirmation, t('users.new.password_confirmation'), class: "form-label"
              = f.password_field :password_confirmation, class: "form-control", required: true
            
            .d-grid
              = f.submit t('users.new.submit'), class: "btn-create"
          
          %hr
          .text-center
            %p
              = t('users.new.have_account')
              = link_to t('users.new.sign_in'), signin_path, class: "btn-link"
