.container.mt-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1= t('users.index.title')
  
  - if @users.any?
    .table-responsive
      %table.table.table-striped.table-hover
        %thead
          %tr
            %th= t('users.index.id')
            %th= t('users.index.name')
            %th= t('users.index.email')
            %th= t('users.index.ratings_count')
            %th= t('users.index.avg_rating')
            %th= t('users.index.show')
        %tbody
          - @users.each do |user|
            %tr
              %td= user.id
              %td= user.name
              %td= user.email
              %td= user.values.count
              %td
                - if user.values.average(:value).present?
                  = user.values.average(:value).round(2)
                - else
                  = t('users.index.no_ratings')
              %td= link_to t('users.index.show'), user_path(user), class: "btn-sm btn-outline-primary"
  - else
    .alert.alert-info.text-center
      = t('users.index.no_users')
