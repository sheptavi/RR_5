.container.mt-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1= t('images.new.title')
    = link_to t('images.new.back'), images_path, class: "btn-create"
  .card.theme-card
    .card-body
      = form_with(model: @image, local: true) do |f|
        .mb-3
          = f.label :name, t('images.new.name'), class: "form-label"
          = f.text_field :name, class: "form-control", required: true
        .mb-3
          = f.label :file, t('images.new.file'), class: "form-label"
          = f.text_field :file, class: "form-control", required: true
        .mb-3
          = f.label :theme_id, t('images.new.theme_id'), class: "form-label"
          = f.collection_select :theme_id, Theme.all, :id, :translated_name, { prompt: t('images.new.select_theme') }, { class: "form-select" }
        .mb-3
          = f.label :ave_value, t('images.new.ave_value'), class: "form-label"
          = f.number_field :ave_value, class: "form-control", step: 0.01
        .d-flex.gap-2
          = f.submit t('images.new.create'), class: "btn-create"
          = link_to t('actions.cancel'), images_path, class: "btn-create"
